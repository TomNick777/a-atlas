# ============================================================
# A-Atlas｜A股星图 — runtime configuration
# ============================================================
# A-Atlas has ONE judgement provider: Jev Cloud (Phase 4 §0/§1).
# There is no Laya here. Laya (:8787, models/, checkpoints) belongs to
# a-share-trawler; A-Atlas neither starts, probes, nor falls back to it.
# Without a key, Discover runs DEGRADED on deterministic retrieval and the UI
# says so — the app still starts and every other page is unaffected.

# --- Jev Cloud (semantic judgement for Discover) ---
# Server-side only. Never read by the browser, never logged, never echoed in an
# error response or screenshot. Get a key at https://typesafe.ai
TYPESAFE_API_KEY=

# Model alias. Pin jev-1.13.0 if you tune thresholds against one version.
# The alias is NOT the identity: /api/health reports the version the cloud
# actually answered with, and telemetry raises MODEL_IDENTITY_MISMATCH on drift.
JEV_MODEL=jev-latest

# Characters of each company profile sent to Jev per finalist.
# (Current dataset profiles top out at 337 chars, so the default never truncates.)
JEV_DETAIL=420

# --- Query parsing (Phase 3.2, Jev-First) ---
# Natural-language queries are compiled by the DETERMINISTIC parser
# (hybrid-parser-v2, lib/hybrid/parser-v2.ts + lib/planner/grammar.ts).
# No LLM, no key, no endpoint: market query language is parsed by code;
# everything the grammar does not claim goes to Jev as the semantic residual.
# The general LLM planner runtime (its keys/endpoints/scripts/fixtures) was
# removed from the production architecture in Phase 3.2.

# Optional: override the SystemOne endpoint. This exists ONLY so CI and the
# fault-injection harness can point at scripts/jev_stub.mjs. Leave unset in
# production; the default is https://api.typesafe.ai/v1/systemone.
#JEV_BASE_URL=http://127.0.0.1:8932

# --- Discover presentation ---
# Companies rendered as live physics bodies at the bottom of the page.
# The search index always covers the whole A-share pool; this only caps the pile.
PHYSICS_POOL_SIZE=300

# --- Search Profile edition (lib/search/edition.ts) ---
# v3 (default) is the production knowledge baseline; v2/v1 pin older editions for
# the A/B benchmark.
#SEARCH_PROFILE_EDITION=v3

# --- Retired options ---
# Laya (LAYA_URL/LAYA_CHECKPOINT/…) belongs to D:\workspace\a-share-trawler.
# The Vibe research variables were retired in the Refocus and are no longer read.

# --- Stock data service (services/stock-data, a-atlas-data) ---
# Thin Python service vendoring simonlin1212/a-stock-data (build-time extraction).
# Second and last local runtime component A-Atlas owns. Company page data blocks
# degrade honestly when it is down; Discover is unaffected.
ATLAS_DATA_URL=http://127.0.0.1:8920
