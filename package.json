{
  "name": "a-atlas",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && npm run test:py",
    "test:public": "vitest run --config vitest.public.config.ts && npm run test:py:public",
    "test:py:public": "python scripts/test_public_python.py",
    "publication:check": "python scripts/check_publication.py",
    "test:py": "python -m unittest discover -s tests -p \"test_stockdata_*.py\" -v",
    "test:jev-live": "tsx scripts/jev_live_suite.ts",
    "quality:discovery": "tsx quality/discovery/runner/run.ts",
    "quality:discovery:review": "tsx quality/discovery/runner/review.ts",
    "quality:discovery:compare": "tsx quality/discovery/runner/compare.ts",
    "semantic:fixtures:refresh": "tsx scripts/semantic_fixtures_refresh.ts",
    "data:fetch": "python -u scripts/fetch_companies.py",
    "data:sw": "python -u scripts/fetch_sw_industry.py",
    "data:profiles": "tsx scripts/build_profiles.ts",
    "data:vectors": "tsx scripts/build_vectors.ts",
    "data": "npm run data:sw && npm run data:fetch && npm run data:profiles && npm run data:vectors",
    "jev:baseline": "tsx scripts/jev_baseline.ts",
    "jev:stub": "node scripts/jev_stub.mjs",
    "jev:assert": "node scripts/assert_jev_stub.mjs",
    "eval": "tsx scripts/eval.ts",
    "eval:retrieval": "tsx scripts/eval.ts --retrieval",
    "eval:lang": "tsx scripts/eval-lang.ts",
    "search-profile:build": "tsx scripts/build_search_profiles_v2.ts",
    "search-profile:build:incremental": "tsx scripts/build_search_profiles_v2.ts --incremental",
    "search-profile:build:v3": "tsx scripts/build_search_profiles_v2.ts --stage3",
    "search-profile:build:v3:incremental": "tsx scripts/build_search_profiles_v2.ts --stage3 --incremental",
    "search-profile:vectors": "tsx scripts/build_vectors_profiles_v2.ts",
    "search-profile:vectors:v3": "tsx scripts/build_vectors_profiles_v2.ts --stage3",
    "search-profile:validate": "tsx scripts/build_search_profiles_v2.ts --validate-only",
    "search-profile:validate:v3": "tsx scripts/build_search_profiles_v2.ts --stage3 --validate-only",
    "search-profile:update": "npm run search-profile:build:incremental && npm run search-profile:vectors",
    "search-profile:update:v3": "npm run search-profile:build:v3:incremental && npm run search-profile:vectors:v3",
    "corpus:build": "tsx scripts/build_company_corpus.ts",
    "corpus:check": "tsx scripts/build_company_corpus.ts --check",
    "corpus:vectors": "tsx scripts/build_vectors_corpus.ts",
    "corpus:update": "npm run corpus:build && npm run corpus:vectors",
    "market:fetch": "python -u scripts/market_fetch.py",
    "market:build": "tsx scripts/build_market_state.ts",
    "market:check": "tsx scripts/build_market_state.ts --check",
    "market:refresh": "tsx scripts/refresh_market.ts",
    "market:prune": "tsx scripts/prune_market_snapshots.ts",
    "market:query": "tsx scripts/market_query.ts",
    "hybrid:query": "tsx scripts/hybrid_query.ts",
    "market:selection:live": "tsx scripts/market_selection_live.ts",
    "stage3:universe": "tsx scripts/stage3_universe.ts",
    "stage3:enrichment": "tsx scripts/stage3_build_enrichment.ts",
    "search:inspect": "tsx scripts/search_inspect.ts",
    "search:export-review": "tsx scripts/search_export_review.ts",
    "search:health": "tsx scripts/search_health.ts",
    "search-profile:health": "tsx scripts/search_profile_health.ts",
    "telemetry:status": "tsx scripts/telemetry_status.ts",
    "telemetry:inspect": "tsx scripts/telemetry_inspect.ts",
    "telemetry:export": "tsx scripts/telemetry_export.ts",
    "telemetry:health": "tsx scripts/telemetry_health.ts",
    "telemetry:rollup": "tsx scripts/telemetry_rollup.ts",
    "test:embeddings:record": "tsx scripts/record_test_query_embeddings.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "matter-js": "^0.20.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
